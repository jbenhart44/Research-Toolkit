cff-version: 1.2.0
title: "Research Amp Toolkit"
message: "If you use this toolkit, please cite it."
type: software
version: "2.1.0"
date-released: "2026-10-20"
authors:
  - family-names: "Benhart"
    given-names: "Jake"
    affiliation: "North Carolina State University — Operations Research"
    email: "jebenhar@ncsu.edu"
repository-code: "https://github.com/jbenhart44/Research-Toolkit"
url: "https://jbenhart44.github.io/toolkit/"
abstract: >
  Verification-first agent engineering for Claude Code: 16 Claude Code
  commands for AI-assisted research — setup (/setup), verification
  (/pcv, /pace, /coa, /audit), workflow bookkeeping (/startup,
  /dailysummary, /weeklysummary, /commit, /simplify, /improve, /runlog),
  content generation (/quarto, /readable, /review), and triage (/help).
  Implements Spec-Driven Development patterns: plan-construct-verify with
  explicit specifications, multi-agent cross-checking, and verifiable
  citation and numerical audits. The release gates are proven by mutation
  checks. Bundles PCV (Plan-Construct-Verify) by Michael G. Kay.
references:
  - type: software
    title: "Plan-Construct-Verify (PCV) — Structured Project Workflow for Claude Code"
    authors:
      - family-names: "Kay"
        given-names: "Michael G."
        affiliation: "North Carolina State University"
    url: "https://mgkay.github.io/pcv/"
keywords:
  - "claude-code"
  - "spec-driven-development"
  - "research-tooling"
  - "verification"
  - "llm-agents"
license: "MIT"
